{
  "expo": {
    "name": "MyPetPair",
    "slug": "mypetpair",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "mypetpair",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mypetpair.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Use your location once to set an approximate dog profile location. You can enter it manually instead.",
        "NSPhotoLibraryUsageDescription": "Choose photos for your dog's profile. Image metadata is removed before publishing.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.mypetpair.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F5EE"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "MyPetPair",
      "shortName": "MyPetPair",
      "description": "Thoughtful introductions for dogs. Nearby discovery and owner-controlled connections."
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your dog's profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location once for an approximate dog profile location."
        }
      ],
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-system-ui"
    ]
  }
}
