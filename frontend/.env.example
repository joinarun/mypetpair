# Public API origin compiled into the client. Never put secrets here.
# Separate local Expo web development:
EXPO_PUBLIC_API_URL=http://localhost:8080
# Native development: replace localhost with a reachable LAN address, or use HTTPS.
# Omit this variable for a Spring-served web export to use same-origin /api.
# Deployed API for native release builds (already set in EAS preview/production):
# EXPO_PUBLIC_API_URL=https://mypetpair-248924650823.us-central1.run.app
# EAS project identity, signing credentials and publisher accounts are supplied by the operator.
