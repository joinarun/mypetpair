# Local only. Spring does not auto-read this file; set environment in the server process.
# If loading with `set -a; source .env; set +a`, quoted JDBC URL preserves its semicolons.
DB_URL="jdbc:h2:file:./.local/mypetpair;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE"
DB_USERNAME=sa
DB_PASSWORD=
APP_INVITATION_REQUIRED=false
APP_INVITATION_CODE=
APP_ADMIN_OWNER_IDS=
APP_SEED=true
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
PORT=8080
# Client origin configuration is frontend/.env.example. EXPO_PUBLIC_ values are public.
